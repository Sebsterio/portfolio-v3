{
	"name": "portfolio-v3",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"e2e": "cross-env CI=1 playwright test",
		"e2e:up": "cross-env CI=1 playwright test --update-snapshots",
		"e2e:dev": "cross-env CI=0 playwright test --ui",
		"verify": "pnpm lint && pnpm typecheck && pnpm test",
		"validate": "pnpm verify && pnpm build && pnpm e2e"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-react": "^0.576.0",
		"motion": "^12.34.4",
		"next": "16.1.6",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@tailwindcss/postcss": "^4.2.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.3.3",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"cross-env": "^10.1.0",
		"eslint": "^10.0.2",
		"eslint-config-next": "^16.1.6",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^28.1.0",
		"postcss": "^8.5.8",
		"prettier": "^3.8.1",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.0.18"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3"
		}
	}
}
